APP_NAME="Auroara LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=auroara_lms
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@auroara.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform Branding (defaults)
PLATFORM_NAME="Auroara LMS"
PLATFORM_COMPANY="Auroara Technologies Sdn Bhd"

# Bluehost SFTP Deploy (used by CI/CD)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/public_html
DEPLOY_KEY=
